# Copy to .env and fill in. Every variable is OPTIONAL -- with none set, the app
# runs in DEMO MODE with sample data, no external services required.

# --- Live data (Google Shopping via SerpApi) ---
# Get a key at https://serpapi.com/. Without it, the app uses demo data.
SERPAPI_KEY=

# --- Persistent cache (recommended in production) ---
# SimpleCache (in-memory) is used when this is empty. On serverless that cache
# dies on every cold start, so use Redis (e.g. Upstash) in production.
# REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# --- Price history (optional) ---
# Set to enable the /history endpoint. Local: sqlite. Prod: a hosted Postgres.
# DATABASE_URL=sqlite:///budgetmart.db
# DATABASE_URL=postgresql://user:pass@host:5432/budgetmart

# --- Security / behaviour ---
# Comma-separated CORS allowlist. Use your frontend origin in production.
# ALLOWED_ORIGINS=https://budgetmart.vercel.app
# RATELIMIT_SEARCH=20 per minute
# DEMO_MODE=false        # force sample data even if a key is set
# MAX_RESULTS=12
